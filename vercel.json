{
  "version": 2,
  "installCommand": "pnpm install --filter local-effort-website... --frozen-lockfile",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "pnpm vite build"
      }
    },
    {
      "src": "backend/api/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "tiny-weddings.localeffortfood.com" }],
      "dest": "https://weddings.localeffortfood.com/$1",
      "status": 308
    },
    {
      "src": "/sales/(?<slug>[^/]+)$",
      "dest": "/api/sales-proxy?path=/$1"
    },
    {
      "src": "/sales/(?<slug>[^/]+)/(?<rest>.*)",
      "dest": "/api/sales-proxy?path=/$1/$2"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/server.js"
    },
    {
      "src": "^/$",
      "dest": "/prerender/index.html"
    },
    {
      "src": "^/about$",
      "dest": "/prerender/about/index.html"
    },
    {
      "src": "^/services$",
      "dest": "/prerender/services/index.html"
    },
    {
      "src": "^/pricing$",
      "dest": "/prerender/pricing/index.html"
    },
    {
      "src": "^/menu$",
      "dest": "/prerender/menu/index.html"
    },
    {
      "src": "^/happy-monday$",
      "dest": "/prerender/happy-monday/index.html"
    },
    {
      "src": "^/gallery$",
      "dest": "/prerender/gallery/index.html"
    },
    {
      "src": "^/meal-prep$",
      "dest": "/prerender/meal-prep/index.html"
    },
    {
      "src": "^/partner-portal$",
      "dest": "/prerender/partner-portal/index.html"
    },
    {
      "src": "^/crowdfunding$",
      "dest": "/prerender/crowdfunding/index.html"
    },
    {
      "src": "^/paikka$",
      "dest": "/prerender/paikka/index.html"
    },
    {
      "src": "^/weddings$",
      "dest": "https://weddings.localeffortfood.com",
      "status": 308
    },
    {
      "src": "^/weddings/(.*)",
      "dest": "https://weddings.localeffortfood.com/$1",
      "status": 308
    },
    {
      "src": "^/tiny-weddings$",
      "dest": "https://weddings.localeffortfood.com",
      "status": 308
    },
    {
      "src": "^/tiny-weddings/(.*)",
      "dest": "https://weddings.localeffortfood.com/$1",
      "status": 308
    },
    {
      "src": "/((?!api|assets|.*\\.|_next).*)",
      "dest": "/index.html"
    }
  ]
}
