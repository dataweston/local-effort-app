{
  "version": 2,
  "installCommand": "pnpm install --filter local-effort-website... --frozen-lockfile",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "pnpm run build"
      }
    },
    {
      "src": "api/sales-proxy.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/store/products.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/store/checkout.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/store/sync-square.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search-images.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sanity-query.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/paikka/pay.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/paikka/checkout.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/paikka/finalize.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/paikka/resend.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/winter-dinner/checkout.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/api/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/sales/(?<slug>[^/]+)$",
      "dest": "/api/sales-proxy.js?path=/$1"
    },
    {
      "src": "/sales/(?<slug>[^/]+)/(?<rest>.*)",
      "dest": "/api/sales-proxy.js?path=/$1/$2"
    },
    {
      "src": "/api/search-images",
      "dest": "/api/search-images.js"
    },
    {
      "src": "/api/sanity-query",
      "dest": "/api/sanity-query.ts"
    },
    {
      "src": "/api/store/products",
      "dest": "/api/store/products.js"
    },
    {
      "src": "/api/store/checkout",
      "dest": "/api/store/checkout.js"
    },
    {
      "src": "/api/store/sync-square",
      "dest": "/api/store/sync-square.js"
    },
    {
      "src": "/api/paikka/pay",
      "dest": "/api/paikka/pay.js"
    },
    {
      "src": "/api/paikka/checkout",
      "dest": "/api/paikka/checkout.js"
    },
    {
      "src": "/api/paikka/finalize",
      "dest": "/api/paikka/finalize.js"
    },
    {
      "src": "/api/paikka/resend",
      "dest": "/api/paikka/resend.js"
    },
    {
      "src": "/api/winter-dinner/checkout",
      "dest": "/api/winter-dinner/checkout.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/server.js"
    },
    {
      "src": "^/$",
      "dest": "/prerender/index.html"
    },
    {
      "src": "^/about$",
      "dest": "/prerender/about/index.html"
    },
    {
      "src": "^/services$",
      "dest": "/prerender/services/index.html"
    },
    {
      "src": "^/pricing$",
      "dest": "/prerender/pricing/index.html"
    },
    {
      "src": "^/menu$",
      "dest": "/prerender/menu/index.html"
    },
    {
      "src": "^/happy-monday$",
      "dest": "/prerender/happy-monday/index.html"
    },
    {
      "src": "^/gallery$",
      "dest": "/prerender/gallery/index.html"
    },
    {
      "src": "^/meal-prep$",
      "dest": "/prerender/meal-prep/index.html"
    },
    {
      "src": "^/partner-portal$",
      "dest": "/prerender/partner-portal/index.html"
    },
    {
      "src": "^/crowdfunding$",
      "dest": "/prerender/crowdfunding/index.html"
    },
    {
      "src": "^/paikka$",
      "dest": "/prerender/paikka/index.html"
    },
    {
      "src": "^/tiny-weddings$",
      "dest": "https://tiny-weddings.localeffortfood.com",
      "status": 308
    },
    {
      "src": "^/tiny-weddings/(.*)",
      "dest": "https://tiny-weddings.localeffortfood.com/$1",
      "status": 308
    },
    {
      "src": "/((?!api|assets|.*\\.|_next).*)",
      "dest": "/index.html"
    }
  ]
}
