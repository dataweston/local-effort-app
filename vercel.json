{
  "version": 2,
  "installCommand": "pnpm install --filter local-effort-website... --frozen-lockfile",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "pnpm vite build"
      }
    },
    {
      "src": "api/store/products.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/store/checkout.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/store/sync-square.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search-images.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sanity-query.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/sanity-health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/_ping.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/api/ping.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/search-images",
      "dest": "/api/search-images.js"
    },
    {
      "src": "/api/sanity-query",
      "dest": "/api/sanity-query.ts"
    },
    {
      "src": "/api/sanity-health",
      "dest": "/api/sanity-health.ts"
    },
    {
      "src": "/api/_ping",
      "dest": "/api/_ping.js"
    },
    {
      "src": "/api/store/products",
      "dest": "/api/store/products.js"
    },
    {
      "src": "/api/store/checkout",
      "dest": "/api/store/checkout.js"
    },
    {
      "src": "/api/store/sync-square",
      "dest": "/api/store/sync-square.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/server.js"
    },
    {
      "src": "^/$",
      "dest": "/prerender/index.html"
    },
    {
      "src": "^/about$",
      "dest": "/prerender/about/index.html"
    },
    {
      "src": "^/services$",
      "dest": "/prerender/services/index.html"
    },
    {
      "src": "^/pricing$",
      "dest": "/prerender/pricing/index.html"
    },
    {
      "src": "^/menu$",
      "dest": "/prerender/menu/index.html"
    },
    {
      "src": "^/happy-monday$",
      "dest": "/prerender/happy-monday/index.html"
    },
    {
      "src": "^/gallery$",
      "dest": "/prerender/gallery/index.html"
    },
    {
      "src": "^/meal-prep$",
      "dest": "/prerender/meal-prep/index.html"
    },
    {
      "src": "^/partner-portal$",
      "dest": "/prerender/partner-portal/index.html"
    },
    {
      "src": "^/crowdfunding$",
      "dest": "/prerender/crowdfunding/index.html"
    },
    {
      "src": "^/paikka$",
      "dest": "/prerender/paikka/index.html"
    },
    {
      "src": "/((?!api|assets|.*\\.|_next).*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_SANITY_PROJECT_ID": "@sanity_project_id",
    "VITE_SANITY_DATASET": "@sanity_dataset",
    "VITE_FIREBASE_API_KEY": "@firebase_api_key_public",
    "VITE_FIREBASE_AUTH_DOMAIN": "@firebase_auth_domain",
    "VITE_FIREBASE_PROJECT_ID": "@firebase_project_id",
    "VITE_FIREBASE_STORAGE_BUCKET": "@firebase_storage_bucket",
    "VITE_FIREBASE_MESSAGING_SENDER_ID": "@firebase_messaging_sender_id",
    "VITE_FIREBASE_APP_ID": "@firebase_app_id"
  }
}
