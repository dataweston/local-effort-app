# Example environment variables for running tests or local server
NODE_ENV=development
PORT=4000
EVENT_ID=local-event
JWT_KID=local-key-id
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Brevo (do NOT commit real keys)
BREVO_API_KEY=
BREVO_TEMPLATE_ID=

# Square (sandbox recommended)
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=sandbox
SQUARE_LOCATION_ID=
# --- Core Environment Variables ---
NODE_ENV=development
PORT=3001
PUBLIC_URL=https://local-effort-app.vercel.app

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase / Firestore ---
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Square ---
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=Sandbox
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=

# --- Brevo (Email) ---
BREVO_API_KEY=
SENDER_EMAIL=
TEAM_INBOX_EMAIL=
SUPPORT_INBOX_EMAIL=
BLOG_ANNOUNCE_TO=

# --- Sanity ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# --- Cookbook external API ---
COOKBOOK_API_BASE=
COOKBOOK_DATA_DIR=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localeffortfood.com

# --- Sentry (Frontend) ---
# Provide DSN from Sentry project settings
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
VITE_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0
VITE_ENV=development

# --- Sentry (Backend) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENV=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=

# --- PM2 / Deployment ---
# Set NODE_ENV=production in environment or via pm2 ecosystem file
# Example: pm2 start ecosystem.config.cjs --env production

# --- Misc ---
GALLANT_ALLOWED_EMAILS=
COOKBOOK_API_BASE=

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=false
LOG_SHIP_ENDPOINT=
# --- Local Office API ---
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=local-office
AUTH_JWT_AUDIENCE=local-office-app
