# ========================================
# BREVO (Email Marketing) Configuration
# ========================================
# Get these from: https://app.brevo.com

# Brevo API Key (required for email integration)
# Get from: Settings → SMTP & API → API Keys
# Example: xkeysib-abc123...
BREVO_API_KEY=

# Pizza Funder Contact List ID(s)
# Get from: Contacts → Lists → (click your list) → check URL for ID number
# Multiple lists: separate with commas (e.g., 123,456)
# Example: 123
BREVO_PIZZAFUNDER_LIST_IDS=

# ========================================
# How to Find Your List ID:
# 1. Go to https://app.brevo.com/contact/list
# 2. Click on "Pizza Backers" (or your list name)
# 3. Check the URL: https://app.brevo.com/contact/list/id/123
# 4. The number (123) is your List ID
# ========================================
