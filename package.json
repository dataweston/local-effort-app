  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ajv": "6.12.6",
    "ajv-keywords": "3.5.2",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "ajv": "6.12.6",
      "ajv-keywords": "3.5.2",
      "typescript": "5.6.3"
    }
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@sentry/cli": "^2.55.0",
    "@sentry/vite-plugin": "^2.21.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/node": "^5.3.26",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "pg": "^8.16.3",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.6.2",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "vite": "^5.1.7",
    "vitest": "^1.6.1",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "pnpm lint:fix",
      "pnpm format",
      "git add"
    ]
  },
  "scripts": {
    "start": "vite",
    "build": "node scripts/generate-sale-page-data.js && node scripts/generate-releases-page-data.js && vite build && node tools/static-export.js && node tools/sync-vercel-routes.js && pnpm run build:prerender:copy",
    "studio:dev": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "studio:deploy": "npm --prefix studio run deploy",
    "studio:deploy-graphql": "npm --prefix studio run deploy-graphql",
    "build:analyze": "SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN vite build --mode production",
    "build:prerender:copy": "node tools/copy-prerender.js",
    "postinstall": "prisma generate",
    "test": "vite test",
    "eject": "vite eject",
    "lint": "eslint \"src/**/*.{js,jsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json,md}\"",
    "reviews:parse": "node tools/parse-thumbtack-widget.js tools/thumbtackwidget.html > public/reviews/thumbtack.json",
    "migrate:gallant": "node tools/firestore-migrate/migrate.js",
    "migrate:gallant:dry": "cross-env FS_MIGRATE_DRYRUN=1 node tools/firestore-migrate/migrate.js",
    "check-format": "prettier --check \"src/**/*.{js,jsx,css,json,md}\"",
    "cloudinary:tag:dry": "node tools/cloudinary-tag-all.js --prefix gallery",
    "cloudinary:tag:apply": "node tools/cloudinary-tag-all.js --prefix gallery --apply",
    "cloudinary:tag:apply:map": "node tools/cloudinary-tag-all.js --prefix gallery --mapFile tools/tag-synonyms.json --apply",
    "emails:extract": "node tools/email-extract.js --include yum@localeffortfood.com",
    "brevo:import": "node tools/brevo-import-csv.mjs",
    "square:to-brevo": "node tools/square-to-brevo.mjs",
    "square:import:brevo": "node tools/square-import-brevo.mjs",
    "backend:start": "node backend/api/server.js",
    "hub:dev-api": "node scripts/dev-hub-api.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:delete": "pm2 delete ecosystem.config.cjs || true",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "release:version": "node -e \"console.log('SENTRY_RELEASE:', process.env.SENTRY_RELEASE || '(unset)')\"",
    "release:new": "node scripts/sentry-release.js new",
    "release:files": "node scripts/sentry-release.js files",
    "release:commits": "node scripts/sentry-release.js commits",
    "release:finalize": "node scripts/sentry-release.js finalize",
    "release:all": "node scripts/sentry-release.js all",
    "build:release": "node scripts/sentry-release.js build",
    "releases:seed": "node scripts/seed-releases-page-content.js",
    "sale:smoke:webhook": "cross-env TS_NODE_PROJECT=tsconfig.ts-node.json node -r ts-node/register/transpile-only scripts/webhook-smoke-test.ts",
    "sale:smoke:webhook:sale": "cross-env TS_NODE_PROJECT=tsconfig.ts-node.json node -r ts-node/register/transpile-only scripts/webhook-smoke-test.ts",
    "sale:smoke:extract": "cross-env TS_NODE_PROJECT=tsconfig.ts-node.json node -r ts-node/register/transpile-only scripts/webhook-smoke-test.ts --extract-only",
    "sale:links:dry": "cross-env TS_NODE_PROJECT=tsconfig.ts-node.json node -r ts-node/register/transpile-only scripts/square-create-links.ts --dry-run",
    "sale:links": "cross-env TS_NODE_PROJECT=tsconfig.ts-node.json node -r ts-node/register/transpile-only scripts/square-create-links.ts",
    "supabase:verify": "cross-env TS_NODE_PROJECT=tsconfig.ts-node.json node -r ts-node/register/transpile-only scripts/supabase-verify.ts",
    "weekly-order:import": "node scripts/weekly-order-import.js",
    "weekly-order:seed": "node scripts/weekly-order-seed.js",
    "weekly-order:prices": "node scripts/weekly-order-prices.js",
    "weekly-order:customer-setup": "node scripts/weekly-order-customer-setup.js",
    "hub:backfill-chef-notes:dry": "node scripts/backfill-hub-chef-notes.js",
    "hub:backfill-chef-notes": "node scripts/backfill-hub-chef-notes.js --apply",
    "hub:smoke:handlers": "node scripts/smoke-hub-handlers.js",
    "decision:seed-priorities:dry": "node scripts/seed-decision-priorities.mjs",
    "decision:seed-priorities": "node scripts/seed-decision-priorities.mjs --apply",
    "neo4j:test": "node scripts/brain-neo4j-test.js",
    "neo4j:brain:sync": "node scripts/brain-neo4j-sync.js",
    "neo4j:brain:sync:reset": "node scripts/brain-neo4j-sync.js --reset"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
