    "dotenv": "^16.4.5",
    "emailjs-com": "^3.2.0",
    "embla-carousel": "^8.1.6",
    "embla-carousel-react": "^8.1.6",
    "express": "^4.19.2",
    "firebase": "^12.3.0",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^12.23.12",
    "google-auth-library": "^10.6.2",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
