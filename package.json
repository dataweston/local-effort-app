    "lucide-react": "^0.451.0",
    "neo4j-driver": "^6.0.1",
    "node-fetch": "^3.3.2",
    "pino": "^9.4.0",
    "pino-http": "^10.1.0",
    "prisma": "^5.20.0",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.3",
    "react": "18.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-image-zooom": "^1.6.0",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.25.1",
    "recharts": "^2.10.3",
    "sigma": "^3.0.2",
    "square": "^37.0.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.5.2",
    "three": "^0.180.0",
    "ui-flat-colors": "^1.0.14",
    "uuid": "^8.3.2",
    "web-push": "^3.6.6",
    "zod": "^3.25.76"
