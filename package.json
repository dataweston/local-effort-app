{
  "name": "local-effort-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for the Local Effort project.",
  "dependencies": {
    "@cloudinary/react": "^1.14.3",
    "@cloudinary/url-gen": "^1.21.0",
    "@noble/ed25519": "^3.0.0",
    "@portabletext/react": "^4.0.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.1.2",
    "@sanity/block-content-to-react": "^3.0.0",
    "@sanity/client": "^7.9.0",
    "@sanity/image-url": "^1.1.0",
    "@sentry/react": "^8.28.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "animejs": "^3.2.2",
    "aws-sdk": "^2.1692.0",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "csv-parse": "^5.5.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "emailjs-com": "^3.2.0",
    "embla-carousel": "^8.1.6",
    "embla-carousel-react": "^8.1.6",
    "express": "^4.19.2",
    "firebase": "^12.1.0",
    "firebase-admin": "^12.5.0",
    "framer-motion": "^12.23.12",
    "jose": "^6.1.0",
    "lucide-react": "^0.451.0",
    "node-fetch": "^3.3.2",
    "pino": "^9.4.0",
    "pino-http": "^10.1.0",
    "prop-types": "^15.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-router": "^6.25.1",
    "react-router-dom": "^6.25.1",
    "recharts": "^2.10.3",
    "square": "^37.0.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.5.2",
    "web-push": "^3.6.6"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ajv": "6.12.6",
    "ajv-keywords": "3.5.2",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "ajv": "6.12.6",
      "ajv-keywords": "3.5.2",
      "typescript": "5.6.3"
    }
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@sentry/cli": "^2.55.0",
    "@sentry/vite-plugin": "^2.21.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.6.2",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
  "typescript": "5.6.3",
    "vite": "^5.1.7",
    "vitest": "^1.6.1",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "pnpm lint:fix",
      "pnpm format",
      "git add"
    ]
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && node tools/static-export.js && pnpm run build:prerender:copy",
    "build:analyze": "SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN vite build --mode production",
    "build:prerender:copy": "node tools/copy-prerender.js",
  "test": "vite test",
    "eject": "vite eject",
    "lint": "eslint \"src/**/*.{js,jsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json,md}\"",
    "reviews:parse": "node tools/parse-thumbtack-widget.js tools/thumbtackwidget.html > public/reviews/thumbtack.json",
    "migrate:gallant": "node tools/firestore-migrate/migrate.js",
    "migrate:gallant:dry": "cross-env FS_MIGRATE_DRYRUN=1 node tools/firestore-migrate/migrate.js",
    "check-format": "prettier --check \"src/**/*.{js,jsx,css,json,md}\"",
    "cloudinary:tag:dry": "node tools/cloudinary-tag-all.js --prefix gallery",
    "cloudinary:tag:apply": "node tools/cloudinary-tag-all.js --prefix gallery --apply",
    "cloudinary:tag:apply:map": "node tools/cloudinary-tag-all.js --prefix gallery --mapFile tools/tag-synonyms.json --apply",
    "emails:extract": "node tools/email-extract.js --include yum@localeffortfood.com",
    "brevo:import": "node tools/brevo-import-csv.mjs",
    "square:to-brevo": "node tools/square-to-brevo.mjs",
    "square:import:brevo": "node tools/square-import-brevo.mjs",
    "backend:start": "node backend/api/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:delete": "pm2 delete ecosystem.config.cjs || true",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "release:version": "node -e \"console.log('SENTRY_RELEASE:', process.env.SENTRY_RELEASE || '(unset)')\"",
    "release:new": "node scripts/sentry-release.js new",
    "release:files": "node scripts/sentry-release.js files",
    "release:commits": "node scripts/sentry-release.js commits",
    "release:finalize": "node scripts/sentry-release.js finalize",
    "release:all": "node scripts/sentry-release.js all",
    "build:release": "node scripts/sentry-release.js build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
