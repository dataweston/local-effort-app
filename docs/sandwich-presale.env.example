# Sandwich presale stack configuration
NODE_ENV=development
PORT=4000
DB_URL=file:./data.db

# Shared routing
EVENT_ID=DEV-EVENT
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# JWT signing
JWT_KID=local-dev
# Optional: provide base64url-encoded Ed25519 keys for deterministic rotation
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Email (Brevo)
BREVO_API_KEY=
BREVO_TEMPLATE_ID=

# Square Payments
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Kiosk renderer
KIOSK_DEV_SERVER_URL=
