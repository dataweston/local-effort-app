# Production environment example for Square + Brevo
# Copy to .env.production (DO NOT COMMIT REAL SECRETS) and set real values.

# Frontend-exposed (Square requires publishing credentials; treat as public):
VITE_SQUARE_ENV=production
VITE_SQUARE_APP_ID=REPLACE_WITH_PRODUCTION_APP_ID
VITE_SQUARE_LOCATION_ID=REPLACE_WITH_PRODUCTION_LOCATION_ID

# Server-side secrets (never exposed in client bundle):
SQUARE_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_ACCESS_TOKEN
BREVO_API_KEY=REPLACE_WITH_BREVO_KEY

# Optional: Force production mode build
NODE_ENV=production

# Any other production-specific flags
# VITE_API_BASE=https://localeffort.app
# Local Office API auth tokens (HMAC secret + optional audience/issuer)
AUTH_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AUTH_JWT_ISSUER=local-office
AUTH_JWT_AUDIENCE=local-office-app
