{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@local-office/ui": ["../../packages/ui/src/index.ts"],
      "@local-office/ui/*": ["../../packages/ui/src/*"],
      "@local-effort/shared": ["../../packages/shared/src/index.ts"],
      "@local-effort/shared/*": ["../../packages/shared/src/*"]
    },
    "types": [
      "next",
      "next/types/global",
      "next/image-types/global",
      "next/image-types",
      "next/navigation-types/compat",
      "react",
      "react-dom"
    ],
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
