{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Label",
  "type": "object",
  "required": [
    "id",
    "orderId",
    "name",
    "item"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "item": {
      "type": "string"
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pdfUrl": {
      "type": "string",
      "format": "uri",
      "nullable": true
    },
    "zplUrl": {
      "type": "string",
      "format": "uri",
      "nullable": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    }
  }
}
