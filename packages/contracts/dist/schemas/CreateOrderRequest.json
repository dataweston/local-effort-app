{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CreateOrderRequest",
  "type": "object",
  "required": [
    "programSlotId",
    "userId",
    "items"
  ],
  "properties": {
    "programSlotId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tip": {
      "type": "number",
      "format": "float",
      "minimum": 0
    },
    "gratuityPercentage": {
      "type": "number",
      "format": "float",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/components/schemas/OrderItemInput"
      }
    }
  }
}
