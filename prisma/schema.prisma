generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SmallEventUser {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  isAdmin      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  sessions     SmallEventSession[]
  estimates    SmallEventEstimate[]
}

model SmallEventSession {
  id        String         @id @default(uuid())
  token     String         @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime       @default(now())
  user      SmallEventUser @relation(fields: [userId], references: [id])
}

model SmallEventEstimate {
  id                 String              @id @default(uuid())
  type               String
  status             String              @default("draft")
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  guestCount         Int?
  eventDate          String?
  eventTime          String?
  alternateDates     String?
  location           String?
  serviceStyle       String?
  budgetRange        String?
  menuNotes          String?
  dietary            String?
  rentals            String?
  notes              String?
  courses            String?
  plannerInfo        String?
  celebrationType    String?
  kitchenAccess      String?
  estimateMinCents   Int?
  estimateMaxCents   Int?
  subtotalCents      Int?
  depositPercent     Int?
  depositAmountCents Int?
  depositStatus      String              @default("unpaid")
  lastEditedAt       DateTime?
  expiresAt          DateTime?
  claimToken         String?             @unique
  userId             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               SmallEventUser?     @relation(fields: [userId], references: [id])
  hold               SmallEventHold?
  payments           SmallEventPayment[]
}

model SmallEventAvailability {
  id        String           @id @default(uuid())
  date      String
  type      String
  status    String
  notes     String?
  source    String           @default("manual")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  holds     SmallEventHold[]

  @@unique([date, type])
}

model SmallEventHold {
  id         String                 @id @default(uuid())
  estimateId String                 @unique
  slotId     String
  status     String                 @default("held")
  holdUntil  DateTime
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  estimate   SmallEventEstimate     @relation(fields: [estimateId], references: [id])
  slot       SmallEventAvailability @relation(fields: [slotId], references: [id])
}

model SmallEventPayment {
  id                  String             @id @default(uuid())
  estimateId          String
  amountCents         Int
  status              String             @default("pending")
  squarePaymentId     String?            @unique
  squarePaymentLinkId String?
  squareOrderId       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  estimate            SmallEventEstimate @relation(fields: [estimateId], references: [id])
}

enum PriceTier {
  subscriber
  member
}

enum UserRole {
  subscriber
  member
  admin
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  role       UserRole  @default(member)
  customerId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id])
  overrides  UserPriceOverride[]
  orders     Order[]
  feedback   DishFeedback[]
  chefNotes  ChefNote[]
  hubProfile HubProfile?
  hubInvitesSent HubInvite[] @relation("hubInviteSentBy")
  hubInvitesAccepted HubInvite[] @relation("hubInviteAcceptedBy")
  hubDocuments HubDocument[] @relation("hubDocumentCreatedBy")
}

model Customer {
  id               String                  @id @default(uuid())
  slug             String                  @unique
  name             String?
  planRulesJson    Json?
  priceTierDefault PriceTier?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  users            User[]
  orders           Order[]
  overrides        CustomerPriceOverride[]
  visibility       DishVisibility[]
  plans            CustomerPlan[]
  profile          CustomerProfile?
}

model Dish {
  id          String                  @id @default(uuid())
  title       String
  description String?
  tags        String[]                @default([])
  categories  String[]                @default([])
  allergens   String[]                @default([])
  status      String                  @default("draft")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  menuItems   MenuWeekItem[]
  prices      DishPrice[]
  overrides   CustomerPriceOverride[]
  userOverrides UserPriceOverride[]
  visibility  DishVisibility[]
  sourceLinks DishSourceLink[]
  orderItems  OrderItem[]
  drafts      DishDraft[]
  feedback    DishFeedback[]
}

model MenuWeek {
  id         String                  @id @default(uuid())
  weekStart  DateTime
  cutoffAt   DateTime
  status     String                  @default("draft")
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  items      MenuWeekItem[]
  sections   MenuWeekSection[]
  prices     DishPrice[]
  overrides  CustomerPriceOverride[]
  visibility DishVisibility[]
  orders     Order[]
  plans      CustomerPlan[]
  userOverrides UserPriceOverride[]
  feedback   DishFeedback[]
}

model MenuWeekItem {
  id            String   @id @default(uuid())
  menuWeekId    String
  dishId        String
  sectionId     String?
  isVisible     Boolean  @default(true)
  isAddon       Boolean  @default(false)
  includedInPlan Boolean @default(false)
  sortOrder     Int      @default(0)
  capacityLimit Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  menuWeek      MenuWeek @relation(fields: [menuWeekId], references: [id])
  dish          Dish     @relation(fields: [dishId], references: [id])
  section       MenuWeekSection? @relation(fields: [sectionId], references: [id])

  @@unique([menuWeekId, dishId])
}

model DishVisibility {
  id         String   @id @default(uuid())
  menuWeekId String
  dishId     String
  customerId String
  canView    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuWeek   MenuWeek @relation(fields: [menuWeekId], references: [id])
  dish       Dish     @relation(fields: [dishId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([menuWeekId, dishId, customerId])
}

model DishPrice {
  id         String    @id @default(uuid())
  menuWeekId String
  dishId     String
  tier       PriceTier
  priceCents Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  menuWeek   MenuWeek  @relation(fields: [menuWeekId], references: [id])
  dish       Dish      @relation(fields: [dishId], references: [id])

  @@unique([menuWeekId, dishId, tier])
}

model CustomerPriceOverride {
  id         String   @id @default(uuid())
  customerId String
  menuWeekId String
  dishId     String
  priceCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  menuWeek   MenuWeek @relation(fields: [menuWeekId], references: [id])
  dish       Dish     @relation(fields: [dishId], references: [id])

  @@unique([customerId, menuWeekId, dishId])
}

model UserPriceOverride {
  id         String   @id @default(uuid())
  userId     String
  menuWeekId String
  dishId     String
  priceCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  menuWeek   MenuWeek @relation(fields: [menuWeekId], references: [id])
  dish       Dish     @relation(fields: [dishId], references: [id])

  @@unique([userId, menuWeekId, dishId])
}

model MenuWeekSection {
  id         String       @id @default(uuid())
  menuWeekId String
  title      String
  slug       String
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  menuWeek   MenuWeek     @relation(fields: [menuWeekId], references: [id])
  items      MenuWeekItem[]

  @@unique([menuWeekId, slug])
}

model CustomerPlan {
  id               String    @id @default(uuid())
  customerId       String
  menuWeekId       String
  basePriceCents   Int
  deliveryFeeCents Int       @default(0)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  customer         Customer  @relation(fields: [customerId], references: [id])
  menuWeek         MenuWeek  @relation(fields: [menuWeekId], references: [id])

  @@unique([customerId, menuWeekId])
}

model Order {
  id              String      @id @default(uuid())
  menuWeekId      String
  customerId      String
  userId          String?
  submittedAt     DateTime?
  status          String      @default("draft")
  squarePaymentId String?
  totalsCents     Int?
  basePriceCents  Int?
  deliveryFeeCents Int?
  notes           String?
  tier            PriceTier?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  menuWeek        MenuWeek    @relation(fields: [menuWeekId], references: [id])
  customer        Customer    @relation(fields: [customerId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  dishId         String
  quantity       Int
  unitPriceCents Int
  isAddon        Boolean  @default(false)
  includedInPlan Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id])
  dish           Dish     @relation(fields: [dishId], references: [id])
}

model RecipeIngest {
  id             String      @id @default(uuid())
  source         String
  externalKey    String?     @unique
  text           String?
  rawPayloadJson Json
  metadata       Json?
  receivedAt     DateTime    @default(now())
  drafts         DishDraft[]
}

model DishDraft {
  id             String       @id @default(uuid())
  sourceIngestId String
  title          String
  description    String?
  categories     String[]     @default([])
  tags           String[]     @default([])
  allergens      String[]     @default([])
  confidence     Float?
  status         String       @default("pending")
  matchedDishId  String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  ingest         RecipeIngest @relation(fields: [sourceIngestId], references: [id])
  matchedDish    Dish?        @relation(fields: [matchedDishId], references: [id])
}

model DishSourceLink {
  id          String   @id @default(uuid())
  dishId      String
  sourceId    String
  externalKey String
  createdAt   DateTime @default(now())
  dish        Dish     @relation(fields: [dishId], references: [id])

  @@unique([sourceId, externalKey])
}

model PlannerCard {
  id           String   @id @default(uuid())
  supabaseUid  String
  templateId   String?
  title        String
  date         String
  dayOfWeek    String
  zone         String   @default("timed")
  people       String[] @default([])
  startTime    String?
  endTime      String?
  revenue      Int      @default(0)
  cost         Int      @default(0)
  costPerHour  Int?
  optional     Boolean  @default(false)
  enabled      Boolean  @default(true)
  effectTarget String?
  effectType   String?
  sortOrder    Float    @default(0)
  status       String   @default("todo")
  projectId    String?
  assigneeId   String?
  priority     Int      @default(0)
  dueDate      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supabaseUid])
  @@index([supabaseUid, date])
  @@index([supabaseUid, templateId])
  @@index([supabaseUid, projectId])
}

model PlannerProject {
  id          String   @id @default(uuid())
  supabaseUid String
  slug        String
  title       String
  description String?
  color       String?
  spaceKey    String?
  targetDate  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([supabaseUid, slug])
  @@index([supabaseUid])
}

model PlannerOverhead {
  id          String   @id @default(uuid())
  supabaseUid String
  name        String
  monthlyCost Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supabaseUid])
}

model PlannerCOGS {
  id          String   @id @default(uuid())
  supabaseUid String
  weekStart   String
  name        String
  amount      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supabaseUid])
  @@index([supabaseUid, weekStart])
}

model GoogleCalendarToken {
  id           String   @id @default(uuid())
  supabaseUid  String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  calendarId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustomerProfile {
  id               String   @id @default(uuid())
  customerId       String   @unique
  householdSize    String?
  phone            String?
  address          String?
  deliveryNotes    String?
  intakeSurvey     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id])
}

model DishFeedback {
  id         String   @id @default(uuid())
  userId     String
  dishId     String
  menuWeekId String
  thumbsUp   Boolean
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  dish       Dish     @relation(fields: [dishId], references: [id])
  menuWeek   MenuWeek @relation(fields: [menuWeekId], references: [id])

  @@unique([userId, dishId, menuWeekId])
}

model ChefNote {
  id         String   @id @default(uuid())
  userId     String
  customerId String
  message    String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model HubOrganization {
  id        String   @id @default(uuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spaces    HubSpace[]
}

model HubProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  email       String    @unique
  displayName String
  accessLevel String    @default("staff")
  title       String?
  phone       String?
  status      String    @default("active")
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([accessLevel])
  @@index([status])
}

model HubInvite {
  id              String    @id @default(uuid())
  token           String    @unique
  email           String
  accessLevel     String    @default("staff")
  displayNameHint String?
  invitedByUserId String?
  acceptedByUserId String?
  acceptedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invitedBy User? @relation("hubInviteSentBy", fields: [invitedByUserId], references: [id])
  acceptedBy User? @relation("hubInviteAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([email])
  @@index([accessLevel])
}

model HubLocalistWindow {
  id             String    @id @default(uuid())
  token          String    @unique
  active         Boolean   @default(true)
  expiresAt      DateTime
  createdByUserId String?
  smsCampaignId  Int?
  smsSentAt      DateTime?
  smsMessage     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, expiresAt])
  @@index([createdAt])
}

model HubLocalistOrder {
  id                   String    @id @default(uuid())
  status               String    @default("checkout_created")
  customerName         String
  customerEmail        String?
  customerPhone        String?
  pickupWindow         String
  customerNote         String?
  localistWindowId     String?
  localistToken        String?
  sourceVisitorId      String?
  sourceSessionId      String?
  entrySource          String?
  squarePaymentLinkId  String?   @unique
  squarePaymentLinkUrl String?
  squareOrderId        String?   @unique
  squarePaymentId      String?   @unique
  squareCustomerId     String?
  squareReceiptUrl     String?
  totalCents           Int
  totalQuantity        Int
  items                Json
  checkoutStartedAt    DateTime  @default(now())
  paidAt               DateTime?
  brainLedgerEventId   String?
  brainInboxItemId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, checkoutStartedAt])
  @@index([paidAt])
  @@index([localistWindowId])
  @@index([sourceSessionId])
}

model HubDocument {
  id          String   @id @default(uuid())
  title       String
  body        String
  summary     String?
  visibility  String   @default("staff")
  category    String   @default("general")
  tags        String[] @default([])
  source      String   @default("manual")
  sourceId    String?
  createdByUserId String?
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("hubDocumentCreatedBy", fields: [createdByUserId], references: [id])

  @@index([visibility])
  @@index([category])
  @@index([status])
  @@unique([source, sourceId])
}

model HubShiftClaim {
  id            String   @id @default(uuid())
  plannerCardId String
  userId        String
  status        String   @default("claimed")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([plannerCardId, userId])
  @@index([plannerCardId])
  @@index([userId])
  @@index([status])
}

model HubSpace {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  title          String
  visibility     String   @default("staff")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization HubOrganization @relation(fields: [organizationId], references: [id])
  memberships  HubSpaceMembership[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model HubSpaceMembership {
  id             String   @id @default(uuid())
  organizationId String
  spaceId        String
  userId         String?
  customerId     String?
  role           String
  visibility     String   @default("customer")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  space HubSpace @relation(fields: [spaceId], references: [id])

  @@index([organizationId, spaceId])
  @@index([userId])
  @@index([customerId])
}

model ObjectThread {
  id             String   @id @default(uuid())
  organizationId String?
  spaceId        String?
  objectType     String
  objectId       String
  visibility     String
  title          String
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages ObjectThreadMessage[]

  @@index([organizationId, spaceId])
  @@index([objectType, objectId])
  @@index([visibility])
}

model ObjectThreadMessage {
  id         String    @id @default(uuid())
  threadId   String
  senderId   String?
  senderRole String?
  body       String
  attachments Json?
  createdAt  DateTime  @default(now())
  editedAt   DateTime?
  deletedAt  DateTime?

  thread ObjectThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@index([senderId])
}

model HubCapture {
  id              String   @id @default(uuid())
  organizationId  String?
  spaceId         String?
  objectId        String?
  objectType      String?
  visibility      String?
  source          String
  sourceId        String?
  actorId         String?
  actorRole       String?
  occurredAt      DateTime @default(now())
  rawContent      String
  attachments     Json?
  clientCreatedAt DateTime?
  offlineQueueId  String?
  captureIntent   String
  ledgerEventId   String?
  status          String   @default("captured")
  routingSuggestions Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([organizationId, spaceId])
  @@index([objectType, objectId])
  @@index([actorId])
  @@index([status, createdAt])
  @@index([offlineQueueId])
  @@index([ledgerEventId])
}

model MobilePushToken {
  id                String   @id @default(uuid())
  userId            String?
  supabaseUid       String?
  platform          String
  pushToken         String   @unique
  deviceId          String?
  permissionsStatus String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastSeenAt        DateTime @default(now())

  @@index([userId])
  @@index([supabaseUid])
  @@index([platform])
}

model DecisionAssignment {
  id            String   @id @default(uuid())
  experimentKey String
  sessionId     String
  variant       String
  bucket        Int
  path          String?
  pageType      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([experimentKey, sessionId])
  @@index([experimentKey, variant])
}

model DecisionEvent {
  id                  String   @id @default(uuid())
  schemaVersion       String
  sessionId           String
  eventType           String
  occurredAt          DateTime
  path                String
  strategy            String
  experimentKey       String?
  variant             String?
  bucket              Int?
  reasonCodes         String[] @default([])
  selectedPriorityIds String[] @default([])
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([experimentKey, variant])
}

// ============================================================================
// COMPANY BRAIN — Layer 1: Ledger
// ============================================================================

model LedgerEventSchema {
  eventType String
  version   Int
  schema    Json
  createdAt DateTime @default(now())

  @@id([eventType, version])
}

model LedgerEvent {
  id              String    @id @default(uuid())
  eventType       String
  schemaVersion   Int       @default(1)
  occurredAt      DateTime
  source          String
  sourceId        String?
  actorType       String?
  actorId         String?
  payload         Json
  createdAt       DateTime  @default(now())
  tombstonedAt    DateTime?
  tombstoneReason String?

  assertions BrainAssertion[]

  @@index([eventType, occurredAt])
  @@index([source, sourceId])
  @@index([occurredAt])
  @@index([tombstonedAt])
}

// ============================================================================
// COMPANY BRAIN — Layer 2: Graph
// ============================================================================

model BrainEntity {
  id          String    @id @default(uuid())
  entityType  String
  name        String
  canonicalName String?
  properties  Json?
  status      String    @default("active")
  snoozeUntil DateTime?
  visibility  String    @default("private")
  shareToken  String?   @unique

  tombstonedAt    DateTime?
  tombstoneReason String?

  localEffortCustomerId String?
  localEffortDishId     String?
  localBudgetVendorId   String?
  squareCustomerId      String?
  plannerCardId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases       BrainEntityAlias[]
  srcAssertions BrainAssertion[]   @relation("assertionSrc")
  dstAssertions BrainAssertion[]   @relation("assertionDst")
  srcInferences BrainInference[]   @relation("inferenceSrc")
  dstInferences BrainInference[]   @relation("inferenceDst")
  inboxItems    BrainInboxItem[]

  @@index([entityType])
  @@index([entityType, canonicalName])
  @@index([status])
  @@index([shareToken])
  @@index([localEffortCustomerId])
  @@index([localEffortDishId])
  @@index([localBudgetVendorId])
}

model BrainEntityAlias {
  id        String      @id @default(uuid())
  entityId  String
  alias     String
  source    String
  createdAt DateTime    @default(now())

  entity BrainEntity @relation(fields: [entityId], references: [id])

  @@unique([entityId, alias])
  @@index([alias])
}

model BrainAssertion {
  id       String @id @default(uuid())
  srcId    String
  dstId    String
  relType  String

  metadata Json?

  validFrom  DateTime  @default(now())
  validUntil DateTime?
  knownFrom  DateTime  @default(now())
  knownUntil DateTime?

  confidence  Float   @default(1.0)
  sourceType  String
  sourceId    String?
  createdBy   String

  supersededBy     String?
  supersededAt     DateTime?
  supersededReason String?

  retractedAt        DateTime?
  retractedBy        String?
  retractedReason    String?
  retractionSourceId String?

  provisional Boolean   @default(false)
  confirmedAt DateTime?
  confirmedBy String?

  createdAt DateTime @default(now())

  src         BrainEntity  @relation("assertionSrc", fields: [srcId], references: [id])
  dst         BrainEntity  @relation("assertionDst", fields: [dstId], references: [id])
  ledgerEvent LedgerEvent? @relation(fields: [sourceId], references: [id])

  @@index([srcId, relType])
  @@index([dstId, relType])
  @@index([validUntil])
  @@index([knownUntil])
  @@index([provisional])
  @@index([retractedAt])
}

// ============================================================================
// COMPANY BRAIN — Layer 3: Inference
// ============================================================================

model BrainInference {
  id            String @id @default(uuid())
  srcId         String
  dstId         String
  inferenceType String

  confidence Float
  decayRate  String

  knownFrom  DateTime  @default(now())
  knownUntil DateTime?

  computedAt   DateTime
  computedFrom String[]

  summary String

  staleAt      DateTime?
  staleReason  String?
  supersededBy String?

  src BrainEntity @relation("inferenceSrc", fields: [srcId], references: [id])
  dst BrainEntity @relation("inferenceDst", fields: [dstId], references: [id])

  @@index([srcId, inferenceType])
  @@index([confidence])
  @@index([staleAt])
  @@index([knownUntil])
}

// ============================================================================
// COMPANY BRAIN — Capture + Auth
// ============================================================================

model BrainInboxItem {
  id             String      @id @default(uuid())
  rawContent     String
  source         String
  attachments    Json?
  capturedAt     DateTime    @default(now())
  status         String      @default("pending")
  processedAt    DateTime?
  resultEntityId String?
  triageHint     Json?

  resultEntity BrainEntity? @relation(fields: [resultEntityId], references: [id])

  @@index([status, capturedAt])
}

model BrainApiToken {
  id         String    @id @default(uuid())
  label      String
  tokenHash  String    @unique
  scopes     String[]
  tokenData  Json?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model BrainSeedReview {
  id          String    @id @default(uuid())
  entityAId   String
  entityBId   String
  matchScore  Float
  matchReason String
  status      String    @default("pending")
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
}
