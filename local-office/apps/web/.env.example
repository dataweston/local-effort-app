# Next.js environment variables (server only unless prefixed with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional client-side read access if using anon key polling
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sale revalidation hook (used by Square webhook & Sanity webhooks)
SALE_REVALIDATE_URL=
SALE_REVALIDATE_SECRET=
