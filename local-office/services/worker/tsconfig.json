{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@local-office/db": [
        "../../packages/db/src"
      ],
      "@local-office/db/*": [
        "../../packages/db/src/*"
      ],
      "@local-office/lib": [
        "../../packages/lib/src"
      ],
      "@local-office/lib/*": [
        "../../packages/lib/src/*"
      ],
      "@local-office/billing": [
        "../billing/src"
      ],
      "@local-office/billing/*": [
        "../billing/src/*"
      ],
      "@local-office/labeler": [
        "../labeler/src"
      ],
      "@local-office/labeler/*": [
        "../labeler/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
